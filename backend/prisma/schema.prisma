generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DISABLED
  PENDING_VERIFICATION
}

model Company {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String?
  logo      String?
  taxNumber String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  status    String    @default("ACTIVE")
  version   Int       @default(1)

  branches         Branch[]
  users            User[]
  departments      Department[]
  designations     Designation[]
  employees        Employee[]
  warehouses       Warehouse[]
  categories       Category[]
  units            Unit[]
  items            Item[]
  vendors          Vendor[]
  demandNotes      DemandNote[]
  vendorQuotations VendorQuotation[]
  purchaseOrders   PurchaseOrder[]
  grns             GoodsReceivingNote[]
  customers        Customer[]
  salesOrders      SalesOrder[]
  boms             BillOfMaterial[]
  productionOrders ProductionOrder[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  payheads         Payhead[]
  payrollPeriods   PayrollPeriod[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  warehouseStock   WarehouseStock[]
  stockLedger      StockLedger[]
  vendorItems      VendorItem[]
  idempotencyKeys  IdempotencyKey[]
  accountingPeriods AccountingPeriod[]
  vouchers         Voucher[]
  fifoLayers       FifoLayer[]
  fifoAllocations  FifoAllocation[]
  materialIssues   MaterialIssue[]
  purchaseReturns  PurchaseReturn[]
  supplierBills    SupplierBill[]
  salesInvoices    SalesInvoice[]
  salesDispatches  SalesDispatch[]
  customerReceipts CustomerReceipt[]
  receiptAllocations ReceiptAllocation[]
  statutoryObligations StatutoryObligation[]
  statutoryPayments   StatutoryPayment[]
  wageRuns            WageRun[]

  @@map("companies")
}

model Warehouse {
  id        String    @id @default(uuid())
  companyId String
  branchId  String?
  name      String
  code      String
  address   String?
  city      String?
  state     String?
  country   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  status    String    @default("ACTIVE")
  version   Int       @default(1)

  company       Company          @relation(fields: [companyId], references: [id])
  branch        Branch?          @relation(fields: [branchId], references: [id])
  stockBalances WarehouseStock[]
  fifoLayers    FifoLayer[]
  materialIssues MaterialIssue[]
  purchaseReturns PurchaseReturn[]
  salesDispatches SalesDispatch[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model Branch {
  id        String    @id @default(uuid())
  companyId String
  name      String
  code      String
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  status    String    @default("ACTIVE")
  version   Int       @default(1)

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]
  warehouses  Warehouse[]

  @@unique([companyId, code])
  @@map("branches")
}

model Department {
  id             String    @id @default(uuid())
  companyId      String
  branchId       String?
  name           String
  code           String?
  description    String?
  headEmployeeId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  status         String    @default("ACTIVE")
  version        Int       @default(1)

  company   Company    @relation(fields: [companyId], references: [id])
  branch    Branch?    @relation(fields: [branchId], references: [id])
  employees Employee[]
  demandNotes DemandNote[]

  @@index([companyId])
  @@map("departments")
}

model Designation {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  code        String
  description String?
  grade       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  status      String    @default("ACTIVE")
  version     Int       @default(1)

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("designations")
}

model Employee {
  id            String    @id @default(uuid())
  companyId     String
  employeeCode  String
  firstName     String
  lastName      String
  email         String    @unique
  phone         String?
  gender        String?
  dateOfBirth   DateTime?
  joiningDate   DateTime?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  departmentId  String?
  designationId String?
  reportsTo     String?
  avatar        String?
  bankName      String?
  bankAccount   String?
  bankIfsc      String?
  panNumber     String?
  aadharNumber  String?
  uanNumber     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  status        String    @default("ACTIVE")
  version       Int       @default(1)

  company     Company      @relation(fields: [companyId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])
  user        User?
  attendance  Attendance[]
  leaves      Leave[]
  paySlips    PaySlip[]
  wageLines   WageLine[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@map("employees")
}

model User {
  id              String     @id @default(uuid())
  companyId       String
  role            String     @default("MEMBER")
  email           String     @unique
  password        String?
  employeeId      String?    @unique
  firebaseUid     String?
  isEmailVerified Boolean    @default(false)
  status          UserStatus @default(PENDING_VERIFICATION)
  lastLoginAt     DateTime?
  loginCount      Int        @default(0)
  refreshToken    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  version         Int        @default(1)

  company       Company        @relation(fields: [companyId], references: [id])
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  notifications Notification[]
  sessions      Session[]

  @@index([companyId])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  userId       String
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActivity DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  status      String    @default("ACTIVE")
  version     Int       @default(1)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  module      String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  status      String    @default("ACTIVE")
  version     Int       @default(1)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  userName  String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@map("notifications")
}

model Category {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  code        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  status      String    @default("ACTIVE")
  version     Int       @default(1)

  company Company @relation(fields: [companyId], references: [id])
  items   Item[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("categories")
}

model Unit {
  id        String    @id @default(uuid())
  companyId String
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?
  status    String    @default("ACTIVE")
  version   Int       @default(1)

  company Company @relation(fields: [companyId], references: [id])
  items   Item[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("units")
}

model Item {
  id             String    @id @default(uuid())
  companyId      String
  itemCode       String
  name           String
  description    String?
  categoryId     String?
  unitId         String?
  brand          String?
  minStock       Float?
  maxStock       Float?
  reorderLevel   Float?
  purchasePrice  Float?
  sellingPrice   Float?
  currentStock   Float     @default(0)
  reservedStock  Float     @default(0)
  availableStock Float     @default(0)
  averageCost    Float     @default(0)
  hsnCode        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  status         String    @default("ACTIVE")
  version        Int       @default(1)

  company              Company               @relation(fields: [companyId], references: [id])
  category             Category?             @relation(fields: [categoryId], references: [id])
  unit                 Unit?                 @relation(fields: [unitId], references: [id])
  purchaseItems        PurchaseOrderItem[]
  grnItems             GoodsReceivingItem[]
  salesOrderItems      SalesOrderItem[]
  boms                 BillOfMaterial[]
  bomMaterials         BOMMaterial[]
  productionOrders     ProductionOrder[]
  materialConsumptions MaterialConsumption[]
  warehouseStock       WarehouseStock[]
  stockLedger          StockLedger[]
  suppliedBy           VendorItem[]
  fifoLayers           FifoLayer[]
  demandNoteItems      DemandNoteItem[]
  materialIssueItems   MaterialIssueItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  supplierBillItems    SupplierBillItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  salesDispatchItems   SalesDispatchItem[]

  @@unique([companyId, itemCode])
  @@index([companyId])
  @@map("items")
}

model Vendor {
  id            String    @id @default(uuid())
  companyId     String
  vendorCode    String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  bankName      String?
  bankAccount   String?
  bankIfsc      String?
  paymentTerms  String?
  taxNumber     String?
  rating        Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  status        String    @default("ACTIVE")
  version       Int       @default(1)

  company        Company              @relation(fields: [companyId], references: [id])
  purchaseOrders PurchaseOrder[]
  quotations     VendorQuotation[]
  grns           GoodsReceivingNote[]
  suppliedItems  VendorItem[]
  purchaseReturns PurchaseReturn[]
  supplierBills   SupplierBill[]

  @@unique([companyId, vendorCode])
  @@index([companyId])
  @@map("vendors")
}

model VendorItem {
  id                   String   @id @default(uuid())
  companyId            String
  vendorId             String
  itemId               String
  preferredSupplier    Boolean  @default(false)
  leadTimeDays         Int?
  minimumOrderQuantity Float?
  unitPrice            Float?
  remarks              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  @@unique([vendorId, itemId])
  @@index([companyId])
  @@index([itemId])
  @@map("vendor_items")
}

model DemandNote {
  id           String    @id @default(uuid())
  companyId    String
  demandNumber String
  departmentId String?
  costCenter   String?
  requestedBy  String?
  priority     String    @default("MEDIUM")
  requiredDate DateTime?
  remarks      String?
  status       String    @default("DRAFT")
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?
  version      Int       @default(1)

  company        Company          @relation(fields: [companyId], references: [id])
  department     Department?      @relation(fields: [departmentId], references: [id])
  items          DemandNoteItem[]
  materialIssues MaterialIssue[]

  @@unique([companyId, demandNumber])
  @@index([companyId])
  @@map("demand_notes")
}

model DemandNoteItem {
  id          String   @id @default(uuid())
  demandId    String
  itemId      String?
  description String?
  quantity    Float
  issuedQty   Float    @default(0)
  unit        String?
  remarks     String?
  createdAt   DateTime @default(now())

  demand             DemandNote          @relation(fields: [demandId], references: [id])
  item               Item?               @relation(fields: [itemId], references: [id])
  materialIssueItems MaterialIssueItem[]

  @@map("demand_note_items")
}

model VendorQuotation {
  id              String    @id @default(uuid())
  companyId       String
  quotationNumber String
  vendorId        String
  demandNoteId    String?
  quotationDate   DateTime?
  deliveryTime    Int?
  warranty        String?
  notes           String?
  status          String    @default("DRAFT")
  totalAmount     Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  version         Int       @default(1)

  company Company               @relation(fields: [companyId], references: [id])
  vendor  Vendor                @relation(fields: [vendorId], references: [id])
  items   VendorQuotationItem[]

  @@unique([companyId, quotationNumber])
  @@index([companyId])
  @@map("vendor_quotations")
}

model VendorQuotationItem {
  id          String   @id @default(uuid())
  quotationId String
  itemId      String?
  description String?
  quantity    Float
  unitPrice   Float
  discountPct Float    @default(0)
  taxPct      Float    @default(0)
  totalPrice  Float
  createdAt   DateTime @default(now())

  quotation VendorQuotation @relation(fields: [quotationId], references: [id])

  @@map("vendor_quotation_items")
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  companyId        String
  poNumber         String
  vendorId         String
  demandNoteId     String?
  quotationId      String?
  orderDate        DateTime?
  expectedDelivery DateTime?
  paymentTerms     String?
  shippingCost     Float     @default(0)
  discountAmount   Float     @default(0)
  taxAmount        Float     @default(0)
  grandTotal       Float     @default(0)
  qtyTolerancePct  Float     @default(0)
  priceTolerancePct Float    @default(0)
  notes            String?
  status           String    @default("DRAFT")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  version          Int       @default(1)

  company Company              @relation(fields: [companyId], references: [id])
  vendor  Vendor               @relation(fields: [vendorId], references: [id])
  items   PurchaseOrderItem[]
  grns    GoodsReceivingNote[]

  @@unique([companyId, poNumber])
  @@index([companyId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id           String   @id @default(uuid())
  poId         String
  itemId       String?
  description  String?
  quantity     Float
  unitPrice    Float
  discountPct  Float    @default(0)
  taxPct       Float    @default(0)
  totalPrice   Float
  receivedQty  Float    @default(0)
  billedQty    Float    @default(0)
  tolerancePct Float?
  createdAt    DateTime @default(now())

  po   PurchaseOrder @relation(fields: [poId], references: [id])
  item Item?         @relation(fields: [itemId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceivingNote {
  id                    String    @id @default(uuid())
  companyId             String
  grnNumber             String
  poId                  String?
  vendorId              String
  warehouseId           String?
  receivedDate          DateTime?
  receivedBy            String?
  notes                 String?
  status                String    @default("DRAFT")
  deliveryChallanNumber String?
  deliveryChallanDate   DateTime?
  supplierInvoiceNumber String?
  supplierInvoiceDate   DateTime?
  supplierInvoiceAmount Float?
  gatePassNumber        String?
  vehicleNumber         String?
  driverName            String?
  driverPhone           String?
  transporterName       String?
  biltyNumber           String?
  departmentId          String?
  costCenter            String?
  inspectionStatus      String    @default("PENDING")
  inspectionNotes       String?
  inspectedBy           String?
  inspectedAt           DateTime?
  voucherId             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  createdBy             String?
  updatedBy             String?
  version               Int       @default(1)

  company           Company              @relation(fields: [companyId], references: [id])
  po                PurchaseOrder?       @relation(fields: [poId], references: [id])
  vendor            Vendor               @relation(fields: [vendorId], references: [id])
  items             GoodsReceivingItem[]
  returns           PurchaseReturn[]
  supplierBillItems SupplierBillItem[]

  @@unique([companyId, grnNumber])
  @@index([companyId])
  @@map("goods_receiving_notes")
}

model GoodsReceivingItem {
  id              String   @id @default(uuid())
  grnId           String
  poItemId        String?
  itemId          String?
  orderedQty      Float    @default(0)
  receivedQty     Float
  acceptedQty     Float
  rejectedQty     Float    @default(0)
  rejectionReason String?
  unitCost        Float    @default(0)
  lotNumber       String?
  remarks         String?
  createdAt       DateTime @default(now())

  grn               GoodsReceivingNote @relation(fields: [grnId], references: [id])
  item              Item?              @relation(fields: [itemId], references: [id])
  supplierBillItems SupplierBillItem[]

  @@map("goods_receiving_items")
}

model Customer {
  id            String    @id @default(uuid())
  companyId     String
  customerCode  String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  paymentTerms  String?
  taxNumber     String?
  rating        Float?
  creditLimit   Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  status        String    @default("ACTIVE")
  version       Int       @default(1)

  company     Company      @relation(fields: [companyId], references: [id])
  salesOrders SalesOrder[]
  invoices    SalesInvoice[]
  dispatches  SalesDispatch[]
  receipts    CustomerReceipt[]

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@map("customers")
}

model SalesOrder {
  id               String    @id @default(uuid())
  companyId        String
  soNumber         String
  customerId       String
  orderDate        DateTime?
  expectedDelivery DateTime?
  paymentTerms     String?
  shippingCost     Float     @default(0)
  discountAmount   Float     @default(0)
  taxAmount        Float     @default(0)
  grandTotal       Float     @default(0)
  notes            String?
  status           String    @default("DRAFT")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  version          Int       @default(1)

  company  Company          @relation(fields: [companyId], references: [id])
  customer Customer         @relation(fields: [customerId], references: [id])
  items    SalesOrderItem[]
  invoices SalesInvoice[]
  dispatches SalesDispatch[]

  @@unique([companyId, soNumber])
  @@index([companyId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String   @id @default(uuid())
  soId         String
  itemId       String?
  description  String?
  quantity     Float
  unitPrice    Float
  discountPct  Float    @default(0)
  taxPct       Float    @default(0)
  totalPrice   Float
  deliveredQty Float    @default(0)
  createdAt    DateTime @default(now())

  so   SalesOrder @relation(fields: [soId], references: [id])
  item Item?      @relation(fields: [itemId], references: [id])

  @@map("sales_order_items")
}

enum BOMStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model BillOfMaterial {
  id          String    @id @default(uuid())
  companyId   String
  bomNumber   String
  itemId      String
  description String?
  quantity    Float     @default(1)
  unit        String?
  wastePct    Float     @default(0)
  status      BOMStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  version     Int       @default(1)

  company          Company           @relation(fields: [companyId], references: [id])
  item             Item              @relation(fields: [itemId], references: [id])
  materials        BOMMaterial[]
  productionOrders ProductionOrder[]

  @@unique([companyId, bomNumber])
  @@index([companyId])
  @@map("bill_of_materials")
}

model BOMMaterial {
  id        String   @id @default(uuid())
  bomId     String
  itemId    String
  quantity  Float
  unit      String?
  scrapPct  Float    @default(0)
  costShare Float?
  createdAt DateTime @default(now())

  bom  BillOfMaterial @relation(fields: [bomId], references: [id])
  item Item           @relation(fields: [itemId], references: [id])

  @@unique([bomId, itemId])
  @@map("bom_materials")
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

model ProductionOrder {
  id               String           @id @default(uuid())
  companyId        String
  productionNumber String
  itemId           String
  bomId            String?
  quantity         Float
  producedQty      Float            @default(0)
  rejectedQty      Float            @default(0)
  startDate        DateTime?
  endDate          DateTime?
  assignedTo       String?
  priority         String           @default("MEDIUM")
  notes            String?
