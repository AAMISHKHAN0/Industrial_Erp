  lines                 WageLine[]

  @@unique([companyId, runNumber])
  @@unique([companyId, periodYear, periodMonth, runType])
  @@index([companyId])
  @@map("wage_runs")
}

model WageLine {
  id          String   @id @default(uuid())
  wageRunId   String
  employeeId  String
  daysWorked  Float
  dailyRate   Float
  grossAmount Float
  deductions  Float    @default(0)
  netAmount   Float
  createdAt   DateTime @default(now())

  wageRun     WageRun  @relation(fields: [wageRunId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@map("wage_lines")
}


